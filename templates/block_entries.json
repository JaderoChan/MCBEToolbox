{
  "block_id": {                         // 方块 ID
    "name":                   "block",  // 方块英文名
    "name_translations": {              // 方块译名（可选）
      "zh":                   "方块"    // 方块中文名
      // ...
    },
    "added_version":          "0.0.0",  // 加入游戏的版本（可选，默认为 0.0.0）
    "default": {                        // 默认的方块数据
      "structure_nbt_id":     "block_structure_nbt_id", // 默认方块 NBT 结构文件 ID
      "command_id":           "block_command_id",       // 默认方块指令 ID
      "textures":             "./textures/block.png",   // 默认方块材质文件路径
      "colors":               "#000000",                // 默认方块颜色
      "attributes": {                // 方块属性（可选，默认均为假）
        "is_incomplete":      false, // 是非完整方块
        "is_transparent":     false, // 是透明/半透明方块
        "is_luminous":        false, // 是发光源
        "is_unstable":        false, // 是不稳定的（会随时间或环境影响，自发发生变化）
        "is_creative":        false, // 仅创造模式可获得
        "has_gravity":        false, // 具有重力的方块
        "has_pattern":        false, // 具有明显花纹/纹理
        "flammable":          false, // 可燃烧的方块
        "enderman_pickable":  false  // 可被末影人拿起的方块
      }
    },
    "variants": { // 不同版本对应的方块数据（可选）
      // 较新版本的字段值在没有指定的情况下使用上一个版本/默认的字段值
      "0.1.0": {  // 具体版本的方块数据
        "structure_nbt_id":   "block_structure_nbt_id_0.1.0", // 方块 NBT 结构文件 ID
        "command_id":         "block_command_id_0.1.0",       // 方块指令 ID
        "textures":           "./textures/block.png",         // 方块材质文件路径（string 或 object 类型）
        "colors":             "#000000"                       // 方块颜色（string 或 object 类型）
      },
      "0.2.0": {
        "command_id":         "block_command_id_0.2.0",
        "textures": {
          "up":               "./textures/block_up.png",
          "down":             "./textures/block_down.png",
          "side":             "./textures/block_side.png"
        },
        "colors": {
          "up":               "#FF0000",
          "down":             "#00FF00",
          "side":             "#0000FF"
        }
      },
      "0.3.0": {
        // textures 和 colors 字段为 object 类型时，具有两种模式：
        // 一种是如同 0.1.0 那样仅指定 up、down 和 side 三个字段
        // 一种是如下一样指定所有面的字段
        "textures": {
          "up":               "./textures/block_up.png",
          "down":             "./textures/block_down.png",
          "north":            "./textures/block_north.png",
          "south":            "./textures/block_south.png",
          "east":             "./textures/block_east.png",
          "west":             "./textures/block_west.png"
        },
        "colors": {
          "up":               "#F00000",
          "down":             "#0F0000",
          "north":            "#00F000",
          "south":            "#000F00",
          "east":             "#0000F0",
          "west":             "#00000F"
        }
      }
      // ...
    }
  }
  // ...
}
